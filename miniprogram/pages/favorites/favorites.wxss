.container {
  padding: 30rpx;
  padding-bottom: 60rpx;
  min-height: 100vh;
  background-color: #f5f0e6;
}

.card {
  background-color: #fffaf0;
  border: 2rpx solid #d4c4a8;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.header {
  text-align: center;
  padding: 40rpx 0;
  margin-bottom: 20rpx;
}

.title-main {
  font-size: 48rpx;
  font-weight: bold;
  color: #2c2416;
  margin-bottom: 10rpx;
  letter-spacing: 8rpx;
}

.subtitle-main {
  font-size: 24rpx;
  color: #8b7355;
  font-style: italic;
}

.project-card {
  position: relative;
}

.project-photos {
  position: relative;
  margin-bottom: 20rpx;
}

.fav-photo-img {
  width: 100%;
  height: 300rpx;
  border-radius: 4rpx;
  background-color: #e8dcc8;
}

.photo-count {
  position: absolute;
  bottom: 10rpx;
  right: 10rpx;
  background-color: rgba(44, 36, 22, 0.8);
  color: #fffaf0;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
}

.project-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.project-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #2c2416;
  flex: 1;
}

.project-tag {
  flex-shrink: 0;
}

.project-desc {
  margin-bottom: 25rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.project-meta {
  display: flex;
  justify-content: space-around;
  padding: 20rpx 0;
  border-top: 1rpx solid #e8dcc8;
  border-bottom: 1rpx solid #e8dcc8;
  margin-bottom: 20rpx;
}

.meta-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.meta-label {
  font-size: 22rpx;
  color: #8b7355;
  margin-bottom: 5rpx;
}

.project-stats {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: #8b7355;
}

.empty-state {
  text-align: center;
  padding: 80rpx 40rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #2c2416;
  margin-bottom: 10rpx;
}

.empty-desc {
  font-size: 24rpx;
  color: #8b7355;
}

/* 空状态和错误态都要给一个出口，
 * 否则用户只能靠下拉刷新碰运气 */
.empty-btn {
  display: inline-block;
  margin-top: 30rpx;
  padding: 16rpx 48rpx;
  border: 2rpx solid #8b4513;
  border-radius: 40rpx;
  color: #8b4513;
  font-size: 26rpx;
}

.loading {
  text-align: center;
  padding: 40rpx;
  color: #8b7355;
}

.no-more {
  text-align: center;
  padding: 40rpx;
  color: #8b7355;
}
