<view class="container">
  <view class="header">
    <view class="title-main">我的收藏</view>
    <view class="subtitle-main">收藏感兴趣的项目</view>
  </view>

  <view class="project-list" wx:if="{{projects.length > 0}}">
    <view wx:for="{{projects}}" wx:key="_id" class="project-card card" bindtap="goToDetail" data-id="{{item._id}}">
      <view wx:if="{{item.cover}}" class="project-photos">
        <image src="{{item.cover}}" mode="aspectFill" class="fav-photo-img" />
        <view wx:if="{{item.photoCount > 1}}" class="photo-count">+{{item.photoCount - 1}}</view>
      </view>

      <view class="project-header">
        <view class="project-title">{{item.title}}</view>
        <view class="project-tag tag">{{item.industry}}</view>
      </view>

      <view class="project-desc text">{{item.description}}</view>

      <view class="project-meta">
        <view class="meta-item">
          <text class="meta-label">投入</text>
          <text class="price-tag">¥{{item.costText}}</text>
        </view>
        <view class="meta-item">
          <text class="meta-label">时长</text>
          <text>{{item.durationText}}</text>
        </view>
        <view class="meta-item">
          <text class="meta-label">团队</text>
          <text>{{item.teamSize}} 人</text>
        </view>
      </view>

      <view class="project-stats">
        <view class="stat-item">
          <text>👁 {{item.views}}</text>
        </view>
        <view class="stat-item">
          <text>❤ {{item.likes}}</text>
        </view>
        <view class="stat-item">
          <text class="date">{{item.createdAtText}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="empty-state card" wx:if="{{notLoggedIn}}">
    <view class="empty-icon">🔒</view>
    <view class="empty-text">需要先登录</view>
    <view class="empty-desc">收藏保存在你的云端账号里</view>
  </view>

  <view class="empty-state card" wx:elif="{{loadError}}">
    <view class="empty-icon">⚠️</view>
    <view class="empty-text">{{loadError}}</view>
    <view class="empty-btn" bindtap="onRetry">重试</view>
  </view>

  <view class="empty-state card" wx:elif="{{!loading && projects.length === 0}}">
    <view class="empty-icon">📚</view>
    <view class="empty-text">暂无收藏</view>
    <view class="empty-desc">去发现感兴趣的项目吧</view>
    <view class="empty-btn" bindtap="goToSearch">去发现</view>
  </view>

  <view wx:if="{{loading}}" class="loading">
    <text>加载中...</text>
  </view>

  <view wx:if="{{!hasMore && projects.length > 0 && !loading}}" class="no-more">
    <text>— 已到底部 —</text>
  </view>
</view>
