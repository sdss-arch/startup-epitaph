.container {
  padding: 30rpx;
  padding-bottom: 60rpx;
  min-height: 100vh;
  background-color: #f5f0e6;
}

.card {
  background-color: #fffaf0;
  border: 2rpx solid #d4c4a8;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #2c2416;
  margin-bottom: 20rpx;
  padding-left: 10rpx;
  border-left: 4rpx solid #d4af37;
}

.header {
  text-align: center;
  padding: 40rpx 0;
  margin-bottom: 20rpx;
}

.title-main {
  font-size: 48rpx;
  font-weight: bold;
  color: #2c2416;
  margin-bottom: 10rpx;
  letter-spacing: 8rpx;
}

.subtitle-main {
  font-size: 24rpx;
  color: #8b7355;
  font-style: italic;
}

.filter-bar {
  display: flex;
  justify-content: center;
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.filter-item {
  padding: 12rpx 30rpx;
  background-color: #fffaf0;
  border: 2rpx solid #d4c4a8;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #8b7355;
  transition: all 0.3s;
}

.filter-item.active {
  background-color: #2c2416;
  color: #fffaf0;
  border-color: #2c2416;
}

.project-card {
  position: relative;
}

.project-photos {
  position: relative;
  margin-bottom: 20rpx;
}

.project-photo-img {
  width: 100%;
  height: 300rpx;
  border-radius: 4rpx;
  background-color: #e8dcc8;
}

.photo-count {
  position: absolute;
  bottom: 10rpx;
  right: 10rpx;
  background-color: rgba(44, 36, 22, 0.8);
  color: #fffaf0;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
}

.project-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.project-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #2c2416;
  flex: 1;
}

.project-tag {
  flex-shrink: 0;
}

.project-desc {
  margin-bottom: 25rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.project-meta {
  display: flex;
  justify-content: space-around;
  padding: 20rpx 0;
  border-top: 1rpx solid #e8dcc8;
  border-bottom: 1rpx solid #e8dcc8;
  margin-bottom: 20rpx;
}

.meta-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.meta-label {
  font-size: 22rpx;
  color: #8b7355;
  margin-bottom: 5rpx;
}

.project-stats {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: #8b7355;
}

.date {
  font-size: 22rpx;
}

.loading, .no-more {
  text-align: center;
  padding: 40rpx;
  color: #8b7355;
  font-size: 26rpx;
}
