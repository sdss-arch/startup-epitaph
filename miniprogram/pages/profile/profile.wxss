.container {
  padding: 30rpx;
  padding-bottom: 60rpx;
  min-height: 100vh;
  background-color: #f5f0e6;
}

.card {
  background-color: #fffaf0;
  border: 2rpx solid #d4c4a8;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #2c2416;
  margin-bottom: 20rpx;
  padding-left: 10rpx;
  border-left: 4rpx solid #d4af37;
}

.profile-header {
  text-align: center;
  padding: 50rpx 30rpx;
}

.avatar {
  width: 150rpx;
  height: 150rpx;
  border-radius: 50%;
  margin: 0 auto 20rpx;
  overflow: hidden;
  border: 4rpx solid #8b7355;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.avatar-default {
  background-color: #2c2416;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fffaf0;
  font-size: 60rpx;
}

.nickname {
  font-size: 36rpx;
  font-weight: bold;
  color: #2c2416;
  margin-bottom: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}

.vip-badge {
  font-size: 22rpx;
}

.vip-section {
  margin-bottom: 30rpx;
}

.vip-section.vip-active {
  background: linear-gradient(135deg, #fff9e6, #fff3cd);
  border-color: #d4af37;
}

.vip-promo {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
}

.vip-icon {
  font-size: 50rpx;
  margin-right: 20rpx;
}

.vip-text {
  flex: 1;
}

.vip-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #8b4513;
  margin-bottom: 5rpx;
}

.vip-desc {
  font-size: 24rpx;
  color: #8b7355;
}

.vip-arrow {
  font-size: 40rpx;
  color: #d4c4a8;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 30rpx;
}

.menu-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
}

.menu-text {
  flex: 1;
  font-size: 30rpx;
  color: #2c2416;
}

.menu-badge {
  background: linear-gradient(135deg, #d4af37, #ffd700);
  color: #2c2416;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  font-weight: bold;
  margin-right: 10rpx;
}

.bio {
  font-size: 26rpx;
  color: #8b7355;
  margin-bottom: 30rpx;
}

.stats-row {
  display: flex;
  justify-content: center;
}

.stat-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #2c2416;
}

.stat-label {
  font-size: 24rpx;
  color: #8b7355;
}

/* 快捷入口 */
.quick-actions {
  display: flex;
  padding: 30rpx;
  margin-bottom: 30rpx;
  gap: 20rpx;
}

.quick-action {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 10rpx;
  position: relative;
}

.quick-icon {
  font-size: 44rpx;
  margin-bottom: 10rpx;
}

.quick-text {
  font-size: 24rpx;
  color: #4a3c2a;
}

.quick-badge {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  background-color: #ff4444;
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 10rpx;
  border-radius: 20rpx;
  min-width: 36rpx;
  text-align: center;
}

.menu-section {
  padding: 10rpx 0;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 30rpx;
}

.menu-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
}

.menu-text {
  flex: 1;
  font-size: 30rpx;
  color: #2c2416;
}

.menu-arrow {
  font-size: 40rpx;
  color: #d4c4a8;
}

.menu-divider {
  height: 1rpx;
  background-color: #e8dcc8;
  margin: 0 30rpx;
}

.about-section {
  text-align: center;
}

.about-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #2c2416;
  margin-bottom: 20rpx;
}

.about-text {
  font-size: 26rpx;
  color: #6b5741;
  line-height: 2;
  margin-bottom: 30rpx;
}

.version {
  font-size: 24rpx;
  color: #8b7355;
}

.debug-section {
  padding: 30rpx;
  margin-top: 20rpx;
}

.debug-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #2c2416;
  margin-bottom: 20rpx;
}

.debug-btn {
  width: 100%;
  margin-bottom: 15rpx;
  background-color: #8b7355;
  color: #fffaf0;
}

.debug-btn-danger {
  background-color: #a85a4a;
}

.debug-btn:last-child {
  margin-bottom: 0;
}
