<view class="container">
  <view class="header">
    <view class="title-main">我的项目</view>
    <view class="subtitle-main">记录你的创业足迹</view>
  </view>

  <view class="project-list" wx:if="{{projects.length > 0}}">
    <view wx:for="{{projects}}" wx:key="_id" class="project-card card">
      <view wx:if="{{item.photos && item.photos.length > 0}}" class="project-photos" bindtap="goToDetail" data-id="{{item._id}}">
        <image src="{{item.photos[0]}}" mode="aspectFill" class="my-projects-photo-img" />
        <view wx:if="{{item.photos.length > 1}}" class="photo-count">+{{item.photos.length - 1}}</view>
      </view>

      <view class="project-header" bindtap="goToDetail" data-id="{{item._id}}">
        <view class="project-title">{{item.title}}</view>
        <view class="project-tag tag">{{item.industry}}</view>
      </view>

      <view class="project-desc text" bindtap="goToDetail" data-id="{{item._id}}">{{item.description}}</view>

      <view class="project-meta">
        <view class="meta-item">
          <text class="meta-label">投入</text>
          <text class="price-tag">¥{{item.cost}}</text>
        </view>
        <view class="meta-item">
          <text class="meta-label">时长</text>
          <text>{{item.duration}}个月</text>
        </view>
        <view class="meta-item">
          <text class="meta-label">团队</text>
          <text>{{item.teamSize}}人</text>
        </view>
      </view>

      <view class="project-stats">
        <view class="stat-item">
          <text>👁 {{item.views}}</text>
        </view>
        <view class="stat-item">
          <text>❤ {{item.likes}}</text>
        </view>
        <view class="stat-item">
          <text class="date">{{item.createdAtText}}</text>
        </view>
      </view>

      <view class="action-bar">
        <button class="action-btn btn-secondary" bindtap="goToEdit" data-id="{{item._id}}">
          编辑
        </button>
        <button class="action-btn btn-delete" bindtap="deleteProject" data-id="{{item._id}}" data-index="{{index}}">
          删除
        </button>
      </view>
    </view>
  </view>

  <view class="empty-state card" wx:if="{{projects.length === 0 && !loading}}">
    <view class="empty-icon">📜</view>
    <view class="empty-text">你还没有发布项目</view>
    <view class="empty-desc">去立碑，分享你的创业故事吧</view>
    <button class="btn-primary" bindtap="goToPublish">去立碑</button>
  </view>

  <view wx:if="{{loading}}" class="loading">
    <text>加载中...</text>
  </view>

  <view wx:if="{{!hasMore && projects.length > 0}}" class="no-more">
    <text>— 已到底部 —</text>
  </view>
</view>
