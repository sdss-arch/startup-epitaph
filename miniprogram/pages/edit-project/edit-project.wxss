.container {
  padding: 30rpx;
  padding-bottom: 60rpx;
  min-height: 100vh;
  background-color: #f5f0e6;
}

.card {
  background-color: #fffaf0;
  border: 2rpx solid #d4c4a8;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.section-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #2c2416;
  margin-bottom: 30rpx;
  text-align: center;
}

.form-item {
  margin-bottom: 30rpx;
}

.form-label {
  font-size: 28rpx;
  color: #2c2416;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.form-input {
  width: 100%;
  height: 72rpx;
  background-color: #fffaf0;
  border: 2rpx solid #d4c4a8;
  border-radius: 4rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #2c2416;
  box-sizing: border-box;
}

.picker {
  width: 100%;
  height: 72rpx;
  background-color: #fffaf0;
  border: 2rpx solid #d4c4a8;
  border-radius: 4rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #2c2416;
  box-sizing: border-box;
  display: flex;
  align-items: center;
}

.form-textarea {
  width: 100%;
  min-height: 150rpx;
  background-color: #fffaf0;
  border: 2rpx solid #d4c4a8;
  border-radius: 4rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #2c2416;
  box-sizing: border-box;
  line-height: 1.6;
}

.form-row {
  display: flex;
  gap: 20rpx;
}

.form-row .form-item {
  flex: 1;
}

.form-row .form-item.half {
  width: 50%;
}

.divider {
  height: 2rpx;
  background-color: #d4c4a8;
  margin: 30rpx 0;
}

.tags-input {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 12rpx;
  background-color: #fffaf0;
  border: 2rpx solid #d4c4a8;
  border-radius: 4rpx;
}

.tag {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  background-color: #e8dcc8;
  color: #6b5741;
  padding: 8rpx 16rpx;
  border-radius: 4rpx;
  font-size: 24rpx;
}

.tag-close {
  font-size: 28rpx;
  line-height: 1;
  cursor: pointer;
}

.tag-input {
  flex: 1;
  min-width: 120rpx;
  font-size: 28rpx;
  background: transparent;
  border: none;
  outline: none;
}

.submit-btn {
  width: 100%;
  margin-top: 20rpx;
}

.photo-upload-section {
  width: 100%;
}

.photo-list {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
}

.photo-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
}

.edit-project-photo-img {
  width: 100%;
  height: 100%;
  border-radius: 8rpx;
  background-color: #e8dcc8;
}

.photo-delete {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 44rpx;
  height: 44rpx;
  background-color: #8b7355;
  color: #fffaf0;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  line-height: 1;
}

.photo-add {
  width: 200rpx;
  height: 200rpx;
  border: 2rpx dashed #d4c4a8;
  border-radius: 4rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background-color: #fffaf0;
}

.photo-add-icon {
  font-size: 60rpx;
  color: #d4c4a8;
  line-height: 1;
  margin-bottom: 10rpx;
}

.photo-add-text {
  font-size: 24rpx;
  color: #8b7355;
}

.loading-page {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100vh;
  color: #8b7355;
  font-size: 28rpx;
}
