.container {
  padding: 30rpx;
  padding-bottom: 60rpx;
  min-height: 100vh;
  background-color: #f5f0e6;
}

.card {
  background-color: #fffaf0;
  border: 2rpx solid #d4c4a8;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.header {
  text-align: center;
  padding: 40rpx 0;
  margin-bottom: 20rpx;
}

.title-main {
  font-size: 48rpx;
  font-weight: bold;
  color: #2c2416;
  margin-bottom: 10rpx;
  letter-spacing: 8rpx;
}

.subtitle-main {
  font-size: 24rpx;
  color: #8b7355;
  font-style: italic;
}

.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 30rpx;
  text-align: center;
}

.stats-grid .stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 48rpx;
  font-weight: bold;
  color: #2c2416;
  margin-bottom: 10rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #8b7355;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #2c2416;
  margin-bottom: 30rpx;
}

.industry-item {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.industry-name {
  width: 180rpx;
  font-size: 28rpx;
  color: #2c2416;
}

.industry-count {
  flex: 1;
  display: flex;
  align-items: center;
}

.count-bar {
  height: 40rpx;
  background: linear-gradient(90deg, #d4c4a8, #8b7355);
  border-radius: 20rpx;
  margin-right: 20rpx;
  min-width: 10rpx;
}

/* 死因分布用更浅一档的填充色，和根因分布形成主次区分 */
.count-bar-alt {
  background: linear-gradient(90deg, #e8dcc4, #b5a184);
}

.count-text {
  font-size: 24rpx;
  color: #8b7355;
  min-width: 40rpx;
}

/* 根因覆盖率 */
.quality-card {
  padding: 26rpx 30rpx;
}

.quality-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 16rpx;
}

.quality-label {
  font-size: 28rpx;
  color: #2c2416;
}

.quality-value {
  font-size: 32rpx;
  font-weight: bold;
  color: #2c2416;
}

.quality-bar .count-bar {
  display: block;
  width: 100%;
  height: 24rpx;
}

.quality-hint {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #8b7355;
  text-align: right;
}

/* 说明性文案：解释图表口径，不是营销语 */
.tip-text {
  font-size: 24rpx;
  color: #8b7355;
  line-height: 1.6;
  margin-bottom: 24rpx;
  padding: 16rpx 20rpx;
  background-color: #f5f0e6;
  border-radius: 10rpx;
}

.truncated-tip {
  font-size: 22rpx;
  color: #8b7355;
  line-height: 1.6;
  text-align: center;
  padding: 20rpx;
}

.error-text {
  display: block;
  margin-bottom: 30rpx;
  text-align: center;
}

.retry-btn {
  margin: 0 auto;
  width: 240rpx;
  background-color: #8b7355;
  color: #fffaf0;
  font-size: 28rpx;
}

.loading-page {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  height: 100vh;
  color: #8b7355;
  font-size: 28rpx;
}
