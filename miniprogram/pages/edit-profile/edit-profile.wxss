.container {
  padding: 30rpx;
  padding-bottom: 60rpx;
  min-height: 100vh;
  background-color: #f5f0e6;
}

.card {
  background-color: #fffaf0;
  border: 2rpx solid #d4c4a8;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.section-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #2c2416;
  margin-bottom: 40rpx;
  text-align: center;
}

.avatar-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 40rpx;
}

.avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background-color: #e8dcc8;
  margin-bottom: 20rpx;
  overflow: hidden;
  border: 4rpx solid #8b7355;
}

.edit-profile-avatar-img {
  width: 100%;
  height: 100%;
}

.avatar-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
  color: #8b7355;
}

.avatar-btn {
  font-size: 26rpx;
  padding: 12rpx 40rpx;
}

.form-item {
  margin-bottom: 30rpx;
}

.form-label {
  font-size: 28rpx;
  color: #2c2416;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.form-input {
  width: 100%;
  height: 88rpx;
  background-color: #fffaf0;
  border: 2rpx solid #d4c4a8;
  border-radius: 4rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #2c2416;
  box-sizing: border-box;
}

.form-textarea {
  width: 100%;
  min-height: 200rpx;
  background-color: #fffaf0;
  border: 2rpx solid #d4c4a8;
  border-radius: 4rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #2c2416;
  box-sizing: border-box;
  line-height: 1.6;
}

.submit-btn {
  width: 100%;
  margin-top: 20rpx;
}
