.container {
  padding: 30rpx;
  padding-bottom: 60rpx;
  min-height: 100vh;
  background-color: #f5f0e6;
}

.card {
  background-color: #fffaf0;
  border: 2rpx solid #d4c4a8;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.search-bar {
  display: flex;
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.search-input {
  flex: 1;
  background-color: #fffaf0;
  border: 2rpx solid #d4c4a8;
  border-radius: 8rpx;
  padding: 20rpx;
  font-size: 28rpx;
}

.search-btn {
  padding: 20rpx 30rpx;
  font-size: 28rpx;
}

.filter-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
  margin-bottom: 30rpx;
}

.filter-tag {
  padding: 12rpx 24rpx;
  background-color: #fffaf0;
  border: 2rpx solid #d4c4a8;
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #8b7355;
}

.filter-tag.active {
  background-color: #2c2416;
  color: #fffaf0;
  border-color: #2c2416;
}

.result-item {
  margin-bottom: 20rpx;
}

.result-photos {
  position: relative;
  margin-bottom: 15rpx;
}

.search-photo-img {
  width: 100%;
  height: 240rpx;
  border-radius: 4rpx;
  background-color: #e8dcc8;
}

.photo-count {
  position: absolute;
  bottom: 10rpx;
  right: 10rpx;
  background-color: rgba(44, 36, 22, 0.8);
  color: #fffaf0;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
}

.result-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #2c2416;
  margin-bottom: 15rpx;
}

.result-desc {
  font-size: 26rpx;
  color: #6b5741;
  margin-bottom: 15rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.result-meta {
  display: flex;
  align-items: center;
  gap: 15rpx;
}

.price {
  font-size: 26rpx;
  color: #a67c52;
  font-weight: bold;
}

.empty, .placeholder {
  text-align: center;
  padding: 100rpx 0;
  color: #8b7355;
  font-size: 28rpx;
}
