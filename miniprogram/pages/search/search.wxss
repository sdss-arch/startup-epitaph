.container {
  padding: 30rpx;
  padding-bottom: 60rpx;
  min-height: 100vh;
  background-color: #f5f0e6;
}

.card {
  background-color: #fffaf0;
  border: 2rpx solid #d4c4a8;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.search-bar {
  display: flex;
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.search-input {
  flex: 1;
  background-color: #fffaf0;
  border: 2rpx solid #d4c4a8;
  border-radius: 8rpx;
  padding: 20rpx;
  font-size: 28rpx;
}

.search-btn {
  padding: 20rpx 30rpx;
  font-size: 28rpx;
}

/* 筛选区块：根因横向滚动，行业换行铺满 */
.filter-block {
  margin-bottom: 24rpx;
}

.filter-label {
  font-size: 24rpx;
  color: #8b7355;
  margin-bottom: 14rpx;
}

.filter-scroll {
  white-space: nowrap;
  width: 100%;
}

.filter-row {
  display: inline-flex;
  align-items: center;
  gap: 15rpx;
  padding-bottom: 8rpx;
}

.filter-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
}

.filter-chip {
  flex-shrink: 0;
  padding: 12rpx 24rpx;
  background-color: #fffaf0;
  border: 2rpx solid #d4c4a8;
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #8b7355;
  white-space: nowrap;
}

.filter-chip.active {
  background-color: #2c2416;
  color: #fffaf0;
  border-color: #2c2416;
}

/* 结果计数条 */
.result-meta-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 24rpx;
  color: #8b7355;
  padding: 10rpx 4rpx 24rpx;
}

.clear-btn {
  color: #a67c52;
  text-decoration: underline;
}

.loading-hint {
  text-align: center;
  color: #8b7355;
  font-size: 26rpx;
  padding: 40rpx 0;
}

/* 结果卡片里的根因标签，比行业标签更强调 */
.root-tag {
  background-color: #f5f0e6;
  border-color: #8b7355;
  color: #2c2416;
}

.empty, .placeholder {
  text-align: center;
  padding: 100rpx 0;
  color: #8b7355;
  font-size: 28rpx;
}

.empty-sub, .placeholder-sub {
  display: block;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #a67c52;
}

.placeholder-title {
  font-size: 32rpx;
  color: #2c2416;
  margin-bottom: 16rpx;
}


.result-item {
  margin-bottom: 20rpx;
}

.result-photos {
  position: relative;
  margin-bottom: 15rpx;
}

.search-photo-img {
  width: 100%;
  height: 240rpx;
  border-radius: 4rpx;
  background-color: #e8dcc8;
}

.photo-count {
  position: absolute;
  bottom: 10rpx;
  right: 10rpx;
  background-color: rgba(44, 36, 22, 0.8);
  color: #fffaf0;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
}

.result-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #2c2416;
  margin-bottom: 15rpx;
}

.result-desc {
  font-size: 26rpx;
  color: #6b5741;
  margin-bottom: 15rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.result-meta {
  display: flex;
  align-items: center;
  gap: 15rpx;
}

.price {
  font-size: 26rpx;
  color: #a67c52;
  font-weight: bold;
}

.empty, .placeholder {
  text-align: center;
  padding: 100rpx 0;
  color: #8b7355;
  font-size: 28rpx;
}
