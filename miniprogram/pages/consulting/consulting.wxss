.container {
  padding: 30rpx;
  padding-bottom: 60rpx;
  min-height: 100vh;
  background-color: #f5f0e6;
}

.card {
  background-color: #fffaf0;
  border: 2rpx solid #d4c4a8;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #2c2416;
  margin-bottom: 20rpx;
}

.tag {
  display: inline-block;
  background: #e8dcc8;
  color: #6b5741;
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
}

.header {
  text-align: center;
  margin-bottom: 40rpx;
}

.header-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #2c2416;
  margin-bottom: 10rpx;
}

.header-desc {
  font-size: 26rpx;
  color: #8b7355;
}

.advisors-list {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
  margin-bottom: 40rpx;
}

.advisor-card {
  position: relative;
  overflow: hidden;
}

.advisor-info {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.advisor-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #d4c4a8;
  flex-shrink: 0;
}

/* 演示数据的 avatar 是空串，<image src=""> 会渲染成裂图，
 * 所以没有头像时用姓氏首字占位 */
.advisor-initial {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #e8dcc8;
  color: #8b4513;
  font-size: 48rpx;
  font-weight: bold;
  line-height: 120rpx;
  text-align: center;
  flex-shrink: 0;
}

.advisor-detail {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.advisor-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #2c2416;
  margin-bottom: 8rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.vip-tag {
  font-size: 20rpx;
}

.advisor-title {
  font-size: 26rpx;
  color: #8b7355;
  margin-bottom: 10rpx;
}

.advisor-industry {
  display: flex;
  gap: 10rpx;
}

.advisor-stats {
  display: flex;
  justify-content: space-around;
  padding: 20rpx 0;
  border-top: 2rpx solid #d4c4a8;
  border-bottom: 2rpx solid #d4c4a8;
  margin-bottom: 20rpx;
}

.stat-item {
  text-align: center;
}

.stat-value {
  font-size: 32rpx;
  font-weight: bold;
  color: #8b4513;
  margin-bottom: 5rpx;
}

.stat-label {
  font-size: 22rpx;
  color: #8b7355;
}

.advisor-bio {
  font-size: 26rpx;
  color: #4a3c2a;
  line-height: 1.7;
  margin-bottom: 20rpx;
}

.advisor-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 20rpx;
}

.small-tag {
  display: inline-block;
  background: #e8dcc8;
  color: #6b5741;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
}

.consult-btn {
  width: 100%;
  background: linear-gradient(135deg, #8b4513, #a0522d);
  color: #fffaf0;
  font-size: 28rpx;
  padding: 20rpx;
  border-radius: 50rpx;
  text-align: center;
}

/* VIP 价按钮：与主按钮同色系但压低对比，避免用户以为这是另一条流程 */
.consult-btn-vip {
  background: #a0522d;
}

.price-now {
  font-size: 32rpx;
}

.price-was {
  font-size: 22rpx;
  color: #8b7355;
  text-decoration: line-through;
  margin-left: 6rpx;
}

.my-consult {
  margin-bottom: 40rpx;
}

.consult-item {
  padding: 20rpx 0;
  border-bottom: 2rpx solid #d4c4a8;
}

.consult-item:last-child {
  border-bottom: none;
}

.consult-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.consult-advisor {
  font-size: 28rpx;
  color: #2c2416;
  font-weight: bold;
}

.consult-status {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
}

/* 状态色。
 * 此前这里直接抄了 Bootstrap 4 的 alert 配色（#d4edda / #d1ecf1 / #f8d7da
 * 等）。它们和本项目的暖色系完全不是一套色，换到页面上会显得像贴上去的；
 * 更麻烦的是 #0c5460、#d1ecf1 的色相是 188.6° / 189.3°，
 * 刚好卡在 check.ps1 的「200°~320° 禁用蓝紫」门槛之外，检查也发现不了。
 * 现在全部换成取自 #f5f0e6 / #8b4513 这一套的同族色。 */
.status-pending_payment {
  background: #f3e3c8;
  color: #7a4b12;
}

.status-pending {
  background: #ece2d0;
  color: #6b5741;
}

.status-confirmed {
  background: #f0dcc8;
  color: #8b4513;
}

.status-completed {
  background: #e5ddd0;
  color: #4a3c2a;
}

.status-cancelled {
  background: #e8dcd2;
  color: #7b4a3a;
}

.consult-time {
  font-size: 24rpx;
  color: #8b7355;
}

.tips-list {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}

.tip-item {
  font-size: 26rpx;
  color: #4a3c2a;
  line-height: 1.6;
}

/* 空状态。advisors 集合为空时至少要让用户知道发生了什么，
 * 否则页面只剩一个标题，看起来像坏了 */
.empty {
  text-align: center;
  padding: 60rpx 30rpx;
}

.empty-title {
  font-size: 30rpx;
  color: #2c2416;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: 24rpx;
  color: #8b7355;
  line-height: 1.7;
}

.tip-warning {
  margin-top: 20rpx;
  padding: 16rpx 20rpx;
  background: #f3e3c8;
  border-left: 6rpx solid #8b4513;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #7a4b12;
  line-height: 1.6;
}
