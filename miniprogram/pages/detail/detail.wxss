.container {
  padding: 30rpx;
  padding-bottom: 60rpx;
  min-height: 100vh;
  background-color: #f5f0e6;
}

.card {
  background-color: #fffaf0;
  border: 2rpx solid #d4c4a8;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.header-section {
  text-align: center;
}

.project-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #2c2416;
  margin-bottom: 20rpx;
}

.project-tags {
  display: flex;
  justify-content: center;
  gap: 15rpx;
}

.stats-section {
  text-align: center;
}

.stat-row {
  display: flex;
  justify-content: space-around;
  padding: 20rpx 0;
}

.stat-row.secondary {
  border-top: 1rpx solid #e8dcc8;
  padding-top: 20rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #2c2416;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #8b7355;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #2c2416;
  margin-bottom: 20rpx;
}

.section-content {
  line-height: 2;
}

.tags-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.photos-list {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
}

.detail-photo-img {
  width: 100%;
  height: 400rpx;
  border-radius: 8rpx;
  background-color: #e8dcc8;
}

.action-section {
  padding: 20rpx;
  display: flex;
  gap: 20rpx;
}

.like-btn {
  flex: 1;
  font-size: 32rpx;
  padding: 30rpx;
}

.favorite-btn {
  flex: 1;
  font-size: 32rpx;
  padding: 30rpx;
}

.favorite-btn.favorited {
  background-color: #2c2416;
  color: #fffaf0;
  border: none;
  border-radius: 4rpx;
}

.comment-input {
  margin-bottom: 30rpx;
}

.input {
  width: 100%;
  min-height: 150rpx;
  background-color: #fffaf0;
  border: 2rpx solid #d4c4a8;
  border-radius: 8rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.comment-item {
  padding: 25rpx 0;
  border-bottom: 1rpx solid #e8dcc8;
}

.comment-item:last-child {
  border-bottom: none;
}

.comment-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 15rpx;
}

.comment-author {
  font-size: 26rpx;
  font-weight: bold;
  color: #2c2416;
}

.comment-date {
  font-size: 22rpx;
  color: #8b7355;
}

.comment-content {
  font-size: 28rpx;
  line-height: 1.8;
}

.empty-text {
  text-align: center;
  color: #8b7355;
  padding: 40rpx 0;
  font-size: 26rpx;
}

.loading-page {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 100vh;
  color: #8b7355;
  font-size: 28rpx;
}
