.container {
  padding: 30rpx;
  padding-bottom: 60rpx;
  min-height: 100vh;
  background-color: #f5f0e6;
}

.card {
  background-color: #fffaf0;
  border: 2rpx solid #d4c4a8;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #2c2416;
  margin-bottom: 20rpx;
  padding-left: 10rpx;
  border-left: 4rpx solid #d4af37;
}

.header {
  padding: 30rpx;
  text-align: center;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #2c2416;
}

.tabs {
  display: flex;
  background-color: #fff;
  padding: 0 30rpx;
  border-bottom: 2rpx solid #e8dcc8;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 30rpx 0;
  font-size: 28rpx;
  color: #8b7355;
  position: relative;
}

.tab.active {
  color: #8b4513;
  font-weight: bold;
}

.tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 4rpx;
  background-color: #8b4513;
  border-radius: 2rpx;
}

.notification-list {
  padding: 20rpx 30rpx;
}

.notification-item {
  display: flex;
  align-items: center;
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
  position: relative;
}

.notification-item.unread {
  background-color: #fffdf8;
}

.notification-item.unread::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 8rpx;
  background-color: #8b4513;
  border-top-left-radius: 16rpx;
  border-bottom-left-radius: 16rpx;
}

.icon-wrapper {
  position: relative;
  margin-right: 24rpx;
}

.notification-icon {
  font-size: 56rpx;
}

.dot {
  position: absolute;
  top: 0;
  right: -4rpx;
  width: 16rpx;
  height: 16rpx;
  background-color: #ff4444;
  border-radius: 50%;
}

.content-wrapper {
  flex: 1;
  min-width: 0;
}

.notification-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #2c2416;
  margin-bottom: 10rpx;
}

.notification-content {
  font-size: 26rpx;
  color: #6b5741;
  margin-bottom: 12rpx;
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.notification-time {
  font-size: 22rpx;
  color: #b09a78;
}

.arrow {
  font-size: 40rpx;
  color: #d4c4a8;
  margin-left: 20rpx;
}

.loading, .empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #8b7355;
}

.no-more {
  text-align: center;
  padding: 40rpx 0;
  color: #b09a78;
  font-size: 24rpx;
}
