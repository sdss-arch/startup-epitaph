# ============================================
#  依赖
# ============================================
node_modules/
miniprogram_npm/
package-lock.json.bak
yarn-error.log
pnpm-debug.log*

# ============================================
#  环境变量与密钥
#  本项目使用云开发的隐式凭证，代码中不应出现任何
#  AppSecret / API Key / Token。出现即视为泄露。
# ============================================
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets.js
credentials.json

# ============================================
#  微信开发者工具 —— 本地私有配置
#  该文件由开发者工具自动生成，含本机路径等个人信息，
#  不应提交。每位开发者本地会自动重建。
# ============================================
project.private.config.json

# ============================================
#  构建产物 / 打包输出
# ============================================
dist/
build/
output/
*.tgz
*.tar.gz

# 云函数本地打包结果
cloudfunctions/**/index.js.bak
cloudfunctions/**/.temp/
.cloud/

# ============================================
#  日志
# ============================================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/
*.log.[0-9]*

# ============================================
#  测试与覆盖率
# ============================================
coverage/
.nyc_output/
*.lcov
.eslintcache
.stylelintcache

# ============================================
#  编辑器 / IDE
# ============================================
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# ============================================
#  操作系统
# ============================================
ehthumbs.db
Desktop.ini
